{
  "name": "sanhith-portfolio",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0 <23"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/generate-csp.mjs",
    "assets:branding": "node scripts/generate-brand-assets.mjs",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "check": "npm run lint && npm run typecheck",
    "test:csp": "node scripts/verify-csp.mjs",
    "build:worker": "opennextjs-cloudflare build && node scripts/apply-asset-csp.mjs",
    "preview": "npm run build:worker && opennextjs-cloudflare preview",
    "deploy": "npm run build:worker && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "next": "16.4.5",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.20.16",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.5",
    "fontkit": "^2.0.4",
    "postcss": "^8.5.29",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^5",
    "wawoff2": "^2.0.1",
    "wrangler": "4.158.0"
  },
  "overrides": {
    "@node-minify/core@9.0.2": {
      "glob": "10.5.0"
    }
  }
}
